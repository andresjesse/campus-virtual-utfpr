# Build-time values for the production image (deploy/Dockerfile).
# Everything here ends up in the public JS bundle: never put secrets in this file.
# Keep these values aligned with src/config/branding.ts.

# The frontend is served by PocketBase itself (pb_public), so the API lives on the same origin.
VITE_POCKETBASE_URL=/
VITE_BRAND_FULL_NAME=UTFPR Virtual
VITE_BRAND_DESCRIPTION=Portal administrativo da UTFPR Virtual
VITE_BRAND_FAVICON=/branding/favicon.svg
VITE_BRAND_THEME_COLOR="#373737"
VITE_BRAND_LOADING_COLOR="#515151"
VITE_BRAND_SOCIAL_IMAGE=/branding/social-preview.svg
# Locale used for search/sort comparisons and date formatting (src/config/locale.ts).
VITE_APP_LOCALE=pt-BR
